{
  "payload": {
    "export": "cart-lines-discounts-generate-run",
    "target": "cart.lines.discounts.generate.run",
    "input": {
      "cart": {
        "lines": [
          {
            "id": "gid://shopify/CartLine/buy",
            "quantity": 1,
            "cost": {
              "amountPerQuantity": {
                "amount": "200.0"
              }
            },
            "merchandise": {
              "id": "gid://shopify/ProductVariant/buy",
              "product": {
                "id": "gid://shopify/Product/buy"
              }
            }
          },
          {
            "id": "gid://shopify/CartLine/get",
            "quantity": 1,
            "cost": {
              "amountPerQuantity": {
                "amount": "100.0"
              }
            },
            "merchandise": {
              "id": "gid://shopify/ProductVariant/get",
              "product": {
                "id": "gid://shopify/Product/get"
              }
            }
          }
        ]
      },
      "discount": {
        "discountClasses": ["PRODUCT"],
        "metafield": {
          "value": "{\"buyProductIds\":[\"gid://shopify/Product/buy\"],\"getProductIds\":[\"gid://shopify/Product/get\"],\"floorPrice\":0.5}"
        }
      }
    },
    "output": {
      "operations": [
        {
          "productDiscountsAdd": {
            "candidates": [
              {
                "message": "Buy X Get Y — get item at minimum price",
                "targets": [
                  {
                    "cartLine": {
                      "id": "gid://shopify/CartLine/get",
                      "quantity": 1
                    }
                  }
                ],
                "value": {
                  "fixedAmount": {
                    "amount": "99.50",
                    "appliesToEachItem": true
                  }
                }
              },
              {
                "message": "Buy X Get Y — qualifying item adjustment",
                "targets": [
                  {
                    "cartLine": {
                      "id": "gid://shopify/CartLine/buy",
                      "quantity": 1
                    }
                  }
                ],
                "value": {
                  "fixedAmount": {
                    "amount": "0.50",
                    "appliesToEachItem": true
                  }
                }
              }
            ],
            "selectionStrategy": "ALL"
          }
        }
      ]
    }
  }
}
